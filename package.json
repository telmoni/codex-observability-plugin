{
  "name": "@telmoni/codex-observability-plugin",
  "version": "0.1.4",
  "description": "Telmoni for Codex: each turn of a session recorded as a run, metadata only",
  "license": "Apache-2.0",
  "author": "Kendrick Lawton",
  "homepage": "https://github.com/telmoni/codex-observability-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telmoni/codex-observability-plugin.git"
  },
  "keywords": [
    "telmoni",
    "codex",
    "plugin",
    "observability",
    "agents"
  ],
  "type": "module",
  "files": [
    ".codex-plugin/plugin.json",
    "hooks",
    "dist"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild": false
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "telmoni": "^0.1.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
