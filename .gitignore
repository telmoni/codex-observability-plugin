# ── Environment ───────────────────────────────────────────────────────────────
.env
# Every copy of it too: a backup like `.env.before-x` holds the same secrets.
.env.*
!.env.example

# ── AI / tooling state ────────────────────────────────────────────────────────
.claude/
# `.agents/plugins/` is the published marketplace; only installed skills
# are local.
.agents/skills/
.gemini/
.aider*
.cursor/
skills

