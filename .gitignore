node_modules/
dist/
# The tarball `npm pack` writes.
*.tgz

# ── Test artifacts ────────────────────────────────────────────────────────────
coverage/

# ── Local ─────────────────────────────────────────────────────────────────────
# The maintainer's own notes, never repo docs.
scratch/
*.log

