node_modules/
coverage/
*.log
*.tgz

# dist/ is not ignored: it is the bundle Codex runs, committed (see .gitattributes).

# Only the plugin's own skill is published: Codex loads every skill under skills/, so anything
# else there is a person's own.
skills/*
!skills/telmoni-observability/

# Environment: a key never belongs in the repository.
.env
.env.*

# A person's own agent settings. `.codex-plugin/` is the published manifest and
# `.agents/plugins/marketplace.json` the marketplace that names it.
.agents/*
!.agents/plugins/
.agents/plugins/*
!.agents/plugins/marketplace.json
.claude/
.codex/
.gemini/

# Editor and OS
.vscode/
.idea/
.zed/
.DS_Store
